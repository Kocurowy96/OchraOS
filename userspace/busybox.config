# SPDX-License-Identifier: MIT OR Apache-2.0
#
# BusyBox configuration for OchraOS: what is set here on top of `make allnoconfig` (every
# other option is off). `cargo xtask build` puts these lines into the generated .config and
# runs `make oldconfig` (see xtask/src/busybox.rs); it fails if one of them does not stay.
#
# The shell, simple tools and file tools (stage 3 brought a writable filesystem), and with
# terminal control (stage 3, P2) line editing, job control and the terminal tools.

# One static binary, linked against musl by the xtask's compiler wrapper.
CONFIG_STATIC=y
CONFIG_BUSYBOX=y
CONFIG_LFS=y

# The shell: ash, also run as `sh`, with its builtins and arithmetic.
CONFIG_SHELL_ASH=y
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y

# Job control (Ctrl-Z, fg, bg, jobs) and line editing with history and Tab completion.
CONFIG_ASH_JOB_CONTROL=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=255
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
CONFIG_FEATURE_EDITING_WINCH=y

# Tools run as separate programs, so the shell's fork, execve and pipes get used.
CONFIG_CAT=y
CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_TEST=y
CONFIG_PRINTF=y
CONFIG_SEQ=y
CONFIG_WC=y
CONFIG_HEAD=y
CONFIG_TR=y
CONFIG_YES=y
CONFIG_KILL=y
CONFIG_SLEEP=y

# Sessions and terminals: a new session with a controlling terminal, terminal settings,
# and the process list from /proc.
CONFIG_SETSID=y
CONFIG_STTY=y
CONFIG_PS=y

# File tools: they create, list, move and remove files and directories through the VFS.
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_RM=y
CONFIG_MV=y
CONFIG_CP=y
CONFIG_LN=y
CONFIG_TOUCH=y
CONFIG_CHMOD=y
